[Unit]
Description=tCam-Mini Proxy Server
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lionel
Group=lionel
WorkingDirectory=/home/lionel/jetson-greenhouse
Environment=PATH=/home/lionel/jetson-greenhouse/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/home/lionel/jetson-greenhouse
ExecStart=/home/lionel/jetson-greenhouse/venv/bin/python /home/lionel/jetson-greenhouse/tcam_proxy_server.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tcam-proxy

# Resource limits
MemoryMax=512M
CPUQuota=50%

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
