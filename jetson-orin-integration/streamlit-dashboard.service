[Unit]
Description=Streamlit Greenhouse Dashboard
After=network.target
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=lionel
Group=lionel
WorkingDirectory=/home/lionel/jetson-greenhouse
Environment=PATH=/home/lionel/jetson-greenhouse/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/lionel/jetson-greenhouse/venv/bin/streamlit run streamlit_dashboard.py --server.port 8083 --server.address 0.0.0.0 --server.headless true
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=streamlit-dashboard

# Resource limits
MemoryMax=1G
CPUQuota=100%

# Security settings
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
